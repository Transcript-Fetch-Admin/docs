{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "TranscriptFetch",
  "description": "Retrieve video transcripts from YouTube, TikTok and Instagram.",
  "colors": {
    "primary": "#3a6b70",
    "light": "#6fa0ae",
    "dark": "#3a6b70"
  },
  "appearance": {
    "default": "light",
    "strict": true
  },
  "background": {
    "color": {
      "light": "#f8f7f5",
      "dark": "#1a1917"
    }
  },
  "fonts": {
    "heading": {
      "family": "Switzer",
      "weight": 400,
      "source": "https://transcriptfetch.com/fonts/Switzer-Regular.woff2",
      "format": "woff2"
    },
    "body": { "family": "Inter", "weight": 400 }
  },
  "logo": "/logo/transcriptfetch.png",
  "styling": { "codeblocks": "dark" },
  "favicon": "/brand-icon.svg",
  "navigation": {
    "tabs": [
      {
        "tab": "Guides",
        "groups": [
          {
            "group": "Start here",
            "pages": [
              "index",
              "quickstart"
            ]
          },
          {
            "group": "Working with transcripts",
            "pages": [
              "guides/transcription",
              "guides/pagination"
            ]
          },
          {
            "group": "SDKs",
            "pages": [
              "sdks/python",
              "sdks/node"
            ]
          }
        ]
      },
      {
        "tab": "API reference",
        "openapi": "openapi.json"
      }
    ]
  },
  "navbar": {
    "links": [
      {
        "label": "Existing docs",
        "href": "https://transcriptfetch.com/docs"
      },
      {
        "label": "Support",
        "href": "mailto:support@transcriptfetch.com"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Dashboard",
      "href": "https://transcriptfetch.com/app"
    }
  },
  "footer": {
    "socials": {
      "github": "https://github.com/TranscriptFetch"
    }
  },
  "banner": {
    "content": "Mintlify trial · Existing documentation remains at [transcriptfetch.com/docs](https://transcriptfetch.com/docs).",
    "dismissible": false
  },
  "seo": {
    "metatags": {
      "robots": "noindex, nofollow"
    }
  },
  "api": {
    "playground": {
      "display": "simple"
    },
    "examples": {
      "languages": [
        "curl",
        "python",
        "javascript"
      ]
    },
    "url": "full"
  }
}
