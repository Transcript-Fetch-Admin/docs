{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "TranscriptFetch",
  "description": "Retrieve video transcripts from YouTube, TikTok and Instagram.",
  "colors": {
    "primary": "#3a6b70",
    "light": "#6fa0ae",
    "dark": "#3a6b70"
  },
  "appearance": {
    "default": "light",
    "strict": true
  },
  "background": {
    "color": {
      "light": "#f8f7f5",
      "dark": "#1a1917"
    }
  },
  "fonts": {
    "heading": {
      "family": "Switzer",
      "weight": 400,
      "source": "https://transcriptfetch.com/fonts/Switzer-Regular.woff2",
      "format": "woff2"
    },
    "body": {
      "family": "Inter",
      "weight": 400
    }
  },
  "logo": "/logo/transcriptfetch.png",
  "styling": {
    "codeblocks": "dark"
  },
  "favicon": "/brand-icon.svg",
  "navigation": {
    "tabs": [
      {
        "tab": "Guides",
        "groups": [
          {
            "group": "Start here",
            "pages": [
              "index",
              "quickstart",
              "request-builder"
            ]
          },
          {
            "group": "Working with transcripts",
            "pages": [
